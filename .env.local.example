# 인기 도구 GA4 조회수 매니페스트 생성용 (scripts/gen-popular.mts).
# 이 파일을 복사해 `.env.local` 로 저장하고 값을 채운 뒤 `npm run gen:popular` 실행.
# .env.local 은 .gitignore(.env*)로 커밋되지 않음 — 절대 실제 키를 커밋하지 말 것.

# GA4 속성 ID(숫자만). GA 관리 > 속성 설정 상단의 '속성 ID'.
GA4_PROPERTY_ID=123456789

# [권장] 서비스 계정 키 JSON '파일 경로' (다운로드한 키 파일, 레포 밖 권장).
#  — 멀티라인 JSON을 붙여넣을 필요 없이 경로만 지정하면 됨.
GOOGLE_APPLICATION_CREDENTIALS=/Users/riemann/keys/youtil-ga4-key.json

# [대안] 파일 경로 대신 JSON 키 전체를 한 줄로 넣고 싶을 때만 사용(Vercel 환경변수 등):
# GA_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...", ...}
